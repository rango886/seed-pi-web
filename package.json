{
  "name": "seed-pi-web",
  "version": "1.0.0",
  "description": "Web UI for pi coding agent (RPC mode)",
  "type": "module",
  "bin": {
    "seed-pi-web": "bin/seed-pi-web.js"
  },
  "files": [
    "bin",
    "server",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "web-ui"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "express": "^5.3.0",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.6",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.2",
    "pele": "^1.13.0",
    "temml": "^0.14.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  }
}
